# BlobMail remains offline unless this is changed to readonly for an explicit probe.
BLOBMAIL_NETWORK_MODE=offline
BLOBMAIL_NETWORK=sepolia

# Public read-only defaults adapted from bonklek/eth-radio at the commit pinned in
# docs/sepolia-provider-profile.md. No wallet, signing, or transaction methods are used.
BLOBMAIL_SEPOLIA_EXECUTION_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOBMAIL_SEPOLIA_BEACON_RPC_URL=https://lodestar-sepolia.chainsafe.io
BLOBMAIL_SEPOLIA_ALLOWED_HOSTS=ethereum-sepolia-rpc.publicnode.com,lodestar-sepolia.chainsafe.io

# The reference batcher is offline by default. In offline mode it verifies and
# packages encrypted entries but cannot claim submission or inclusion.
BLOBMAIL_BATCHER_MODE=offline
BLOBMAIL_BATCHER_HOST=127.0.0.1
BLOBMAIL_BATCHER_PORT=8787
BLOBMAIL_BATCHER_ALLOWED_ORIGIN=http://127.0.0.1:5173

# Live Sepolia mode is an explicit operator capability. Keep the funded key in
# the process environment or a secret manager, never in this file or the repo.
# BLOBMAIL_BATCHER_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BLOBMAIL_BATCHER_PRIVATE_KEY=
# BLOBMAIL_BATCHER_GAS_LIMIT=80000
# BLOBMAIL_BATCHER_MAX_FEE_PER_GAS_WEI=20000000000
# BLOBMAIL_BATCHER_MAX_PRIORITY_FEE_PER_GAS_WEI=1000000000
# BLOBMAIL_BATCHER_MAX_FEE_PER_BLOB_GAS_WEI=20000000000
# BLOBMAIL_BATCHER_MAX_TOTAL_EXPOSURE_WEI=5000000000000000
